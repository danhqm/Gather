# Local development only. Copy to .env and replace with a random password.
POSTGRES_PASSWORD=replace-with-a-random-local-password
# Optional: 12–128 characters, including upper/lowercase, number and symbol.
# Seeds organiser@gather.test and staff@gather.test on the local demo.
DEMO_ACCOUNT_PASSWORD=
# Optional sandbox Checkout. Prefer a restricted test key; live keys are rejected.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_METHOD_CONFIGURATION=
